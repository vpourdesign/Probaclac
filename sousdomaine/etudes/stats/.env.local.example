# ── Google Analytics 4 ──────────────────────────────────────────────────
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=   # JSON complet en base64: base64 -i service-account.json

# ── Google Search Console ────────────────────────────────────────────────
GSC_SITE_URL=https://probaclac.ca/

# ── Filtrage par page (optionnel) ────────────────────────────────────────
# Si défini, le dashboard affiche uniquement les stats de cette URL.
# Si vide/absent, affiche les stats globales du site.
DASHBOARD_PAGE_URL=https://etudes.probaclac.ca/sci

# ── Meta Ads ─────────────────────────────────────────────────────────────
META_ACCESS_TOKEN=             # token longue durée (60j) — business.facebook.com
META_AD_ACCOUNT_ID=act_XXXXXXXXX

# ── Auth simple (middleware) ─────────────────────────────────────────────
DASHBOARD_PASSWORD=probaclac2024
