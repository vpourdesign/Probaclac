/* Render mega menu product grid */
function renderMega(filter="all"){
  const grid = document.getElementById("megaGrid");
  if(!grid) return;
  grid.innerHTML = CATALOGUE
    .filter(r => filter==="all" || r.cat===filter)
    .map(r => `
      <a class="mega__card" href="${r.url}" data-cat="${r.cat}">
        <div class="mega__card-img"><img src="${r.img}" alt="Probaclac ${r.name}" loading="lazy"></div>
        <span class="mega__card-cat">${r.catLabel}</span>
        <span class="mega__card-name">Probaclac ${r.name}</span>
        <span class="mega__card-meta">${r.meta}</span>
      </a>
    `).join("");
}
renderMega();

document.querySelectorAll(".mega__cats button").forEach(b => {
  b.addEventListener("click", () => {
    document.querySelectorAll(".mega__cats button").forEach(x => x.setAttribute("aria-selected","false"));
    b.setAttribute("aria-selected","true");
    renderMega(b.dataset.cat);
  });
});

/* Megamenu open/close */
(function setupMega(){
  const btn = document.getElementById("megaToggle");
  const mega = document.getElementById("mega");
  const bd  = document.getElementById("megaBackdrop");
  if(!btn || !mega) return;
  let open = false;
  function setOpen(v){
    open = v;
    btn.setAttribute("aria-expanded", v ? "true" : "false");
    mega.classList.toggle("is-open", v);
    bd.classList.toggle("is-open", v);
    if(v){ mega.removeAttribute("hidden"); } else { setTimeout(()=>mega.setAttribute("hidden",""), 450); }
  }
  btn.addEventListener("click", e => { e.preventDefault(); setOpen(!open); });
  bd.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", e => { if(e.key === "Escape" && open) setOpen(false); });
})();

/* (Catalogue index section removed — no-op) */

/* ─────────────────────────────────────────────────────────────────
   Manifesto — word/char split for reveal
   ───────────────────────────────────────────────────────────────── */
(function splitManifesto(){
  const el = document.querySelector("[data-split]");
  if(!el) return;
  // Wrap each word in <span class="word"><span>word</span></span>, preserving inner spans (accent)
  const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null);
  const txts = [];
  while(walker.nextNode()) txts.push(walker.currentNode);
  txts.forEach(t => {
    const words = t.nodeValue.split(/(\s+)/);
    const frag = document.createDocumentFragment();
    words.forEach(w => {
      if(w.trim()===""){ frag.appendChild(document.createTextNode(w)); return; }
      const wrap = document.createElement("span");
      wrap.className = "word";
      const inner = document.createElement("span");
      inner.textContent = w;
      wrap.appendChild(inner);
      frag.appendChild(wrap);
    });
    t.parentNode.replaceChild(frag, t);
  });
  // The accent span — wrap its text content too
  el.querySelectorAll(".accent").forEach(acc => {
    const txt = acc.textContent;
    acc.innerHTML = "";
    txt.split(/(\s+)/).forEach(w => {
      if(w.trim()===""){ acc.appendChild(document.createTextNode(w)); return; }
      const wrap = document.createElement("span");
      wrap.className = "word";
      const inner = document.createElement("span");
      inner.textContent = w;
      wrap.appendChild(inner);
      acc.appendChild(wrap);
    });
  });
})();

/* ─────────────────────────────────────────────────────────────────
