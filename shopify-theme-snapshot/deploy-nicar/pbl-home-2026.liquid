  .from(".hero__eyebrow .right .pill", { y: 18, opacity: 0, duration: .7, stagger: .08 }, .05)
  .from(".hero__h1 .w > span", { y: "110%", opacity: 0, duration: 1, stagger: .07, clipPath: "inset(0 0 100% 0)" }, .15)
  .from(".hero__sub", { y: 24, opacity: 0, duration: .9 }, .55)
  .from(".hero__ctas .btn", { y: 24, opacity: 0, duration: .8, stagger: .08 }, .7)
  .from(".hero__foot .stat", { y: 24, opacity: 0, duration: .8, stagger: .08 }, .9);

// Manifesto words reveal
ScrollTrigger.batch(".manifesto__quote .word > span", {
  start: "top 80%",
  onEnter: batch => gsap.to(batch, { y: 0, duration: 1.1, ease: "power4.out", stagger: .02 }),
  once: true,
});

// Pillars stagger
gsap.utils.toArray(".pillar").forEach((p, i) => {
  gsap.to(p, {
    opacity: 1, y: 0,
    duration: 1,
    ease: "power3.out",
    delay: i * 0.08,
    scrollTrigger: { trigger: p, start: "top 85%" },
  });
});

// Generic reveal
gsap.utils.toArray(".reveal").forEach(el => {
  gsap.to(el, {
    opacity:1, y:0,
    duration: 1,
    ease: "power3.out",
    scrollTrigger: { trigger: el, start: "top 85%" },
  });
});

