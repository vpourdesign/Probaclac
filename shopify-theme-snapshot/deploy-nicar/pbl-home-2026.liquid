gsap.registerPlugin(ScrollTrigger);

// Nav scrolled state
const nav = document.getElementById("nav");
ScrollTrigger.create({
  start: "top -10",
  end: "max",
  onUpdate: self => nav.classList.toggle("scrolled", self.scroll() > 12),
});

// Hero reveal
const heroTl = gsap.timeline({ defaults: { ease: "power3.out" } });
heroTl
