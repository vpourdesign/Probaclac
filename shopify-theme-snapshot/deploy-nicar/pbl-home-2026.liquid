{% comment %} PROBACLAC HOMEPAGE 2026 — editorial B&W, scoped under .pblx {% endcomment %}
<style>
.pblx{
  --ink: #0a0a0a;
  --paper: #fafaf7;
  --rule: rgba(10,10,10,.12);
  --rule-strong: rgba(10,10,10,.22);
  --mute: rgba(10,10,10,.56);
  --accent: #ff5b04;

  --margin: clamp(1.25rem, 4vw, 4rem);
  --gutter: clamp(1rem, 2vw, 2rem);

  --t-micro: .72rem;
  --t-body: clamp(.95rem, 1vw + .55rem, 1.05rem);
  --t-lead: clamp(1.05rem, .6vw + .9rem, 1.25rem);
  --t-h3: clamp(1.25rem, 1vw + 1rem, 1.65rem);
  --t-h2: clamp(2.25rem, 5vw, 5.5rem);
  --t-h1: clamp(2.5rem, 6.5vw, 7rem);
  --t-display: clamp(4rem, 16vw, 17rem);

  --ease: cubic-bezier(.16,1,.3,1);
}
.pblx *, .pblx *::before, .pblx *::after{ box-sizing: border-box; }
.pblx{ -webkit-text-size-adjust:100%; }
.pblx{ margin:0; padding:0; }
.pblx{
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-weight: 400;
  font-size: var(--t-body);
  line-height: 1.5;
  letter-spacing: -.005em;
  color: var(--ink);
  background: var(--paper);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  overflow-x: hidden;
}
.pblx img, .pblx svg{ display:block; max-width:100%; height:auto; }
.pblx a{ color:inherit; text-decoration:none; }
.pblx button{ font:inherit; color:inherit; background:none; border:0; padding:0; cursor:pointer; }
.pblx .bold{ font-weight:700; letter-spacing:-.04em; }
.pblx .light{ font-weight:300; }
.pblx .italic{ font-style:italic; }
.pblx .eyebrow{
  font-size: var(--t-micro);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .22em;
}
.pblx .eyebrow .dot{
  display:inline-block;
  width:.42em; height:.42em;
  border-radius:50%;
  background: var(--accent);
  vertical-align: middle;
  margin: 0 .58em 0 0;
  transform: translateY(-1px);
}
.pblx .rule{ height:1px; background:var(--rule); border:0; }
.pblx .rule.strong{ background:var(--rule-strong); }
.pblx .btn{
  display:inline-flex; align-items:center; gap:.7em;
  font-weight:700; letter-spacing:-.01em;
  font-size: .92rem;
  padding: 1.05rem 1.6rem;
  border-radius: 999px;
  border: 1px solid currentColor;
  transition: transform .5s var(--ease), background .35s var(--ease), color .35s var(--ease);
  white-space: nowrap;
}
.pblx .btn .arr{
  display:inline-block;
  transition: transform .5s var(--ease);
}
.pblx .btn:hover .arr{ transform: translateX(.25em); }
.pblx .btn--solid{ background:var(--ink); color:var(--paper); border-color:var(--ink); }
.pblx .btn--solid:hover{ background: var(--accent); border-color: var(--accent); color: var(--ink); }
.pblx .btn--ghost{ background:transparent; }
.pblx .btn--ghost:hover{ background: var(--ink); color: var(--paper); }
.pblx .on-dark .btn--solid{ background:var(--paper); color:var(--ink); border-color:var(--paper); }
.pblx .on-dark .btn--solid:hover{ background: var(--accent); border-color: var(--accent); color: var(--ink); }
.pblx .on-dark .btn--ghost{ color:var(--paper); border-color: rgba(255,255,255,.4); }
.pblx .on-dark .btn--ghost:hover{ background: var(--paper); color: var(--ink); border-color:var(--paper); }
.pblx .on-dark{ background:var(--ink) !important; color:var(--paper); }
.pblx .on-dark .rule{ background: rgba(255,255,255,.16); }
.pblx .on-dark .rule.strong{ background: rgba(255,255,255,.3); }
.pblx .on-dark .mute{ color: rgba(255,255,255,.55); }
.pblx .mute{ color: var(--mute); }
.pblx .section{ padding: clamp(4rem, 9vw, 9rem) var(--margin); position:relative; }
.pblx .section--tight{ padding: clamp(3rem, 5vw, 5rem) var(--margin); }
.pblx .wrap{ max-width: 1480px; margin:0 auto; }
.pblx .g12{ display:grid; grid-template-columns:repeat(12,1fr); gap: var(--gutter); }
.pblx .on-dark{ position: relative; isolation: isolate; }
.pblx .progress{
  position: fixed; top: 0; left: 0; right: 0;
  height: 2px;
  background: rgba(10,10,10,.06);
  z-index: 60;
  pointer-events: none;
}
.pblx .progress__bar{
  height: 100%; width: 0;
  background: var(--accent);
  transform-origin: left;
}
.pblx .cursor{
  position: fixed; top: 0; left: 0;
  width: 14px; height: 14px; border-radius: 50%;
  background: var(--accent);
  pointer-events: none;
  z-index: 100;
  mix-blend-mode: difference;
  transform: translate3d(-50%, -50%, 0);
  transition: width .35s var(--ease), height .35s var(--ease), background .25s var(--ease);
  opacity: 0;
}
.pblx .cursor.is-hover{
  width: 48px; height: 48px;
}

@media (hover: none), (max-width: 760px){.pblx .cursor{ display: none; }}
.pblx .chap{
  position: fixed; top: 86px; right: var(--margin);
  display: flex; flex-direction: column; align-items: flex-end; gap: .35rem;
  z-index: 45;
  font-size: var(--t-micro); text-transform: uppercase; letter-spacing: .22em;
  font-weight: 700;
  pointer-events: none;
  opacity: 0;
  transition: opacity .6s var(--ease);
}
.pblx .chap.is-visible{ opacity: 1; }
.pblx .chap__num{ color: var(--accent); font-variant-numeric: tabular-nums; }
.pblx .chap__title{ color: inherit; opacity: .55; }
.pblx .chap.on-dark__chap .chap__title{ color: var(--paper); }
.pblx.is-ready .reveal{ opacity:0; transform: translateY(28px); will-change: opacity, transform; }
.pblx.is-ready .reveal.visible{ opacity:1; transform:none; transition: opacity .9s var(--ease), transform .9s var(--ease); }
.pblx .nav{
  position: fixed; top:0; left:0; right:0; z-index:50;
  display:flex; align-items:center; justify-content:space-between;
  padding: .9rem var(--margin);
  background: rgba(250,250,247,.78);
  backdrop-filter: blur(14px) saturate(1.2);
  -webkit-backdrop-filter: blur(14px) saturate(1.2);
  border-bottom: 1px solid transparent;
  transition: border-color .4s var(--ease), background .4s var(--ease);
}
.pblx .nav.scrolled{ border-bottom-color: var(--rule); }
.pblx .nav__logo{
  display:flex; align-items:center;
}
.pblx .nav__logo img{
  height: clamp(28px, 3vw, 40px);
  width: auto;
  display: block;
}
.pblx .nav__links{
  display:flex; gap: clamp(1.25rem, 2.4vw, 2.4rem);
  font-size: .88rem; font-weight: 400;
}
.pblx .nav__links a{
  position:relative; padding: .5em 0;
}
.pblx .nav__links a::after{
  content:""; position:absolute; left:0; right:100%; bottom:.2em;
  height:1px; background: currentColor;
  transition: right .45s var(--ease);
}
.pblx .nav__links a:hover::after{ right:0; }
.pblx .nav__right{
  display:flex; align-items:center; gap:1.15rem;
  font-size: .82rem; font-weight: 400;
}
.pblx .nav__lang{ letter-spacing: .1em; text-transform: uppercase; font-weight: 700; font-size: .72rem; }
.pblx .nav__lang .sep{ margin: 0 .35em; opacity:.45; }
.pblx .nav__icobtn{
  width:34px; height:34px; border-radius:50%;
  border:1px solid var(--rule-strong);
  display:flex; align-items:center; justify-content:center;
  transition: background .35s var(--ease), color .35s var(--ease), border-color .35s var(--ease);
}
.pblx .nav__icobtn:hover{ background:var(--ink); color:var(--paper); border-color: var(--ink); }
.pblx .nav__icobtn svg{ width:14px; height:14px; }


@media (max-width: 860px){.pblx .nav__links{ display:none; }}
.pblx .nav__btn{
  font: inherit; font-size:.88rem; font-weight:400;
  position:relative; padding: .5em 0; color: inherit;
  display:inline-flex; align-items:center; gap: .35em;
}
.pblx .nav__btn::after{
  content:""; position:absolute; left:0; right:100%; bottom:.2em;
  height:1px; background: currentColor;
  transition: right .45s var(--ease);
}
.pblx .nav__btn:hover::after, .pblx .nav__btn[aria-expanded="true"]::after{ right:0; }
.pblx .nav__btn .chev{
  width: 9px; height: 9px; display:inline-block;
  border-right: 1.4px solid currentColor; border-bottom: 1.4px solid currentColor;
  transform: rotate(45deg) translate(-2px, -2px);
  transition: transform .35s var(--ease);
  margin-left:.1em;
}
.pblx .nav__btn[aria-expanded="true"] .chev{ transform: rotate(-135deg) translate(-2px, -2px); }
.pblx .mega{
  position: fixed; left:0; right:0; top: 64px;
  background: var(--paper);
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  z-index: 49;
  padding: clamp(1.5rem, 3vw, 2.5rem) var(--margin) clamp(1.5rem, 2.5vw, 2rem);
  transform: translateY(-8px);
  opacity: 0;
  pointer-events: none;
  transition: opacity .45s var(--ease), transform .55s var(--ease);
  max-height: calc(100vh - 64px);
  overflow-y: auto;
}
.pblx .mega.is-open{ opacity:1; transform: translateY(0); pointer-events: auto; }
.pblx .mega__backdrop{
  position: fixed; inset: 64px 0 0 0;
  background: rgba(10,10,10,.18);
  opacity: 0;
  pointer-events: none;
  transition: opacity .45s var(--ease);
  z-index: 48;
}
.pblx .mega__backdrop.is-open{ opacity:1; pointer-events:auto; }
.pblx .mega__inner{
  display:grid;
  grid-template-columns: minmax(0, 3fr) minmax(0, 7fr) minmax(0, 2.5fr);
  gap: clamp(1.5rem, 3vw, 3rem);
  max-width: 1480px; margin: 0 auto;
}
.pblx .mega__left .eyebrow{ color: var(--mute); }
.pblx .mega__left h3{
  font-weight:700; letter-spacing:-.035em;
  font-size: clamp(1.5rem, 2.4vw, 2.1rem); line-height: 1;
  margin: .75rem 0 1.5rem;
  max-width: 14ch;
}
.pblx .mega__cats{
  list-style:none; padding:0; margin:0;
  display:flex; flex-direction:column;
  border-top: 1px solid var(--rule);
}
.pblx .mega__cats button{
  width:100%; text-align:left;
  display:flex; justify-content:space-between; align-items:center;
  padding: 1rem 0; gap:1rem;
  border-bottom: 1px solid var(--rule);
  font-size: .95rem;
  font-weight: 700; letter-spacing: -.015em;
  transition: color .3s var(--ease), padding .45s var(--ease);
}
.pblx .mega__cats button:hover{ padding-left: .35rem; }
.pblx .mega__cats button .count{
  font-size: var(--t-micro); letter-spacing: .15em;
  color: var(--mute); font-weight:700;
  font-variant-numeric: tabular-nums;
}
.pblx .mega__cats button[aria-selected="true"]{ color: var(--accent); }
.pblx .mega__cats button[aria-selected="true"] .count{ color: var(--accent); }
.pblx .mega__grid{
  display:grid;
  grid-template-columns: repeat(4, 1fr);
  gap: .65rem;
}
.pblx .mega__card{
  display:flex; flex-direction: column;
  padding: .8rem;
  border: 1px solid var(--rule);
  border-radius: 18px;
  background: #fff;
  transition: border-color .3s var(--ease), transform .45s var(--ease), background .3s var(--ease), color .3s var(--ease);
}
.pblx .mega__card:hover{ border-color: var(--ink); transform: translateY(-2px); }
.pblx .mega__card[data-hidden="true"]{ display:none; }
.pblx .mega__card-img{
  aspect-ratio: 1/1; width:100%;
  display:flex; align-items:center; justify-content:center;
  border-radius: 12px;
  margin-bottom: .65rem;
  overflow: hidden;
}
.pblx .mega__card-img img{ width: 100%; height: 100%; object-fit: contain; }
.pblx .mega__card-cat{
  font-size: .62rem; text-transform: uppercase; letter-spacing: .2em;
  color: var(--mute); font-weight:700;
}
.pblx .mega__card-name{
  font-weight: 700; letter-spacing: -.02em;
  font-size: .92rem; line-height: 1.15;
  margin: .15rem 0 .25rem;
}
.pblx .mega__card-meta{
  font-size: .72rem; color: var(--mute); line-height: 1.35;
}
.pblx .mega__right{ display:flex; flex-direction: column; gap: 1rem; }
.pblx .mega__help{
  border: 1px solid var(--rule-strong);
  border-radius: 22px;
  padding: 1.25rem;
  background: #fff;
}
.pblx .mega__help .eyebrow{ color: var(--mute); }
.pblx .mega__help h4{
  font-weight:700; letter-spacing:-.025em;
  font-size: 1.1rem; line-height: 1.15;
  margin: .65rem 0 .5rem;
}
.pblx .mega__help p{ font-size: .85rem; color: var(--mute); margin: 0 0 1rem; }
.pblx .mega__help a{
  display:inline-flex; align-items:center; gap: .4em;
  font-size: .85rem; font-weight: 700; letter-spacing: -.01em;
  color: var(--accent);
}
.pblx .mega__help a svg{ width: 14px; height: 14px; }
.pblx .mega__stat{
  border: 1px solid var(--ink);
  border-radius: 22px;
  padding: 1.25rem;
  background: var(--ink); color: var(--paper);
}
.pblx .mega__stat .num{
  font-weight:700; letter-spacing:-.04em;
  font-size: clamp(2.5rem, 4vw, 3.5rem); line-height: .95;
}
.pblx .mega__stat .num .sym{ color: var(--accent); }
.pblx .mega__stat .num .unit{ font-size:.4em; vertical-align:super; margin-left:.1em; color: rgba(255,255,255,.55); font-weight:300; letter-spacing: 0; }
.pblx .mega__stat p{ font-size:.85rem; color: rgba(255,255,255,.7); margin: .75rem 0 0; line-height: 1.4; }
.pblx .mega__stat a{ color: var(--accent); font-weight:700; }


@media (max-width: 1100px){.pblx .mega__inner{ grid-template-columns: 1fr; }
.pblx .mega__grid{ grid-template-columns: repeat(3, 1fr); }
.pblx .mega__cats{ flex-direction: row; flex-wrap: wrap; border-top: 0; }
.pblx .mega__cats button{ border-bottom: 0; padding: .5rem .9rem; border: 1px solid var(--rule-strong); border-radius: 999px; }}

@media (max-width: 720px){.pblx .mega__grid{ grid-template-columns: repeat(2, 1fr); }}
.pblx .hero{
  padding-top: clamp(6.5rem, 11vh, 10rem);
  padding-bottom: clamp(2rem, 3.5vw, 3.5rem);
  display:flex; flex-direction:column;
}
.pblx .hero__eyebrow{
  display:flex; align-items:center; justify-content:space-between;
  gap:1.25rem; flex-wrap:wrap;
}
.pblx .hero__eyebrow .left{ display:flex; align-items:center; gap:.7rem; }
.pblx .hero__eyebrow .right{ display:flex; align-items:center; gap:.75rem; font-size: var(--t-micro); }
.pblx .hero__eyebrow .right .pill{
  padding: .3em .75em;
  border: 1px solid var(--rule-strong);
  border-radius:999px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .15em;
}
.pblx .hero__body{
  margin-top: clamp(1.5rem, 3vw, 2.5rem);
  display:grid;
  grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  gap: clamp(2rem, 4vw, 4rem);
  align-items: center;
}

@media (max-width: 880px){.pblx .hero__body{ grid-template-columns: 1fr; gap: 1.5rem; }}
.pblx .hero__left{ display:flex; flex-direction: column; gap: clamp(1.25rem, 2vw, 1.75rem); }
.pblx .hero__right{ position: relative; display:flex; align-items:center; justify-content:center; }
.pblx .hero__h1{
  font-weight:700; letter-spacing:-.045em;
  font-size: var(--t-h1);
  line-height: .95;
  margin: 0;
  color: var(--ink);
}
.pblx .hero__h1 .pulse{
  display:inline-block; vertical-align:middle;
  width:.22em; height:.22em; border-radius:50%;
  background: var(--accent);
  transform: translateY(.06em) scale(0);
  animation: dotPop 1.2s var(--ease) 1.3s forwards;
}
.pblx .hero__h1{ color: var(--ink); }

@keyframes dotPop{
  0%   { transform: translateY(.06em) scale(0); }
  60%  { transform: translateY(.06em) scale(1.2); }
  100% { transform: translateY(.06em) scale(1); }
}
.pblx .hero__sub{
  max-width: 34rem;
  font-size: var(--t-lead);
  line-height: 1.45;
  color: var(--mute);
  font-weight: 300;
}
.pblx .hero__ctas{
  display:flex; gap: .75rem; flex-wrap: wrap;
}
.pblx .hero-bottle{
  position: relative;
  display:flex; flex-direction: column; align-items:center;
  gap: .9rem;
  width: 100%;
}
.pblx .hero-bottle__stack{
  position: relative;
  width: 100%;
  max-width: clamp(340px, 38vw, 540px);
  
  aspect-ratio: 1 / 1.18;
}
.pblx .hcard{
  position: absolute; left: 0; right: 0; top: 0;
  aspect-ratio: 1 / 1;
  border-radius: 26px;
  overflow: hidden;
  border: 1px solid var(--rule-strong);
  background: #f3f1e9;
  box-shadow:
    0 2px 6px rgba(10,10,10,.06),
    0 18px 40px rgba(10,10,10,.14);
  will-change: transform, opacity;
  transform-origin: center top;
}
.pblx .hcard img{ width: 100%; height: 100%; object-fit: cover; display: block; }
.pblx .hcard:nth-child(1){ z-index: 30; }
.pblx .hcard:nth-child(2){ z-index: 20; transform: translateY(38px) scale(.955); opacity: .78; }
.pblx .hcard:nth-child(3){ z-index: 10; transform: translateY(70px) scale(.91); opacity: .45; }
.pblx .hero-bottle__caption{
  display: flex; flex-direction: column; align-items: center; gap: .9rem;
  text-align: center;
}
.pblx .hero-bottle__name{
  font-weight: 700; letter-spacing: -.02em;
  font-size: clamp(1.05rem, 1.3vw, 1.25rem);
  line-height: 1.15;
  color: var(--ink);
  min-height: 1.4em;
}
.pblx .hero-bottle__dots{
  display:flex; gap: .5rem;
}
.pblx .hero-bottle__dots button{
  width: 9px; height: 9px; border-radius:50%;
  border: 0;
  background: var(--rule-strong);
  padding: 0;
  transition: background .35s var(--ease), transform .35s var(--ease);
  cursor: pointer;
}
.pblx .hero-bottle__dots button[aria-selected="true"]{
  background: var(--ink);
  transform: scale(1.25);
}


@media (max-width: 880px){.pblx .hero__right{ margin-top: 1.5rem; }
.pblx .hero-bottle__stack{ max-width: clamp(260px, 70vw, 360px); }}
.pblx .hero__foot{
  margin-top: clamp(2rem, 4vw, 3.25rem);
  display:grid; grid-template-columns: repeat(3, 1fr); gap: 0;
  border-top: 1px solid var(--rule);
  padding-top: 1.5rem;
}
.pblx .trust{
  display:flex; align-items:center; justify-content:center; gap: .8rem;
  position: relative;
  padding: .5rem 1rem;
}
.pblx .trust + .trust::before{
  content: "";
  position: absolute; left: 0; top: 12%; bottom: 12%;
  width: 1px;
  background: var(--rule);
}
.pblx .trust__num{
  font-weight: 700; letter-spacing: -.03em;
  font-size: clamp(1.5rem, 2vw, 1.85rem);
  line-height: 1;
  color: var(--ink);
  flex: 0 0 auto;
}
.pblx .trust__img{
  width: clamp(30px, 3.2vw, 40px); height: auto;
  flex: 0 0 auto;
}
.pblx .trust__ico{
  width: clamp(30px, 3.2vw, 38px); height: clamp(30px, 3.2vw, 38px);
  border-radius: 50%;
  border: 1px solid var(--ink);
  color: var(--ink);
  display: flex; align-items: center; justify-content: center;
  flex: 0 0 auto;
}
.pblx .trust__ico svg{ width: 55%; height: 55%; }
.pblx .trust__lbl{
  font-weight: 700; letter-spacing: -.005em;
  font-size: clamp(.85rem, .95vw, .95rem);
  line-height: 1.2;
  color: var(--ink);
}


@media (max-width: 720px){.pblx .hero__foot{ grid-template-columns: 1fr; row-gap: 0; }
.pblx .trust{ padding: 1rem; }
.pblx .trust + .trust::before{
    left: 12%; right: 12%; top: 0; bottom: auto; width: auto; height: 1px;
  }}
.pblx .vedettes{ padding-top: clamp(4rem, 7vw, 6rem); padding-bottom: clamp(4rem, 7vw, 6rem); }
.pblx .vedettes__head{
  display:flex; justify-content: space-between; align-items: end; gap: var(--gutter);
  margin-bottom: clamp(2rem, 3vw, 2.5rem);
}
.pblx .vedettes__head h2{
  font-weight:700; letter-spacing:-.035em;
  font-size: clamp(1.75rem, 3.5vw, 3rem); line-height: 1;
  margin: .5rem 0 0;
}
.pblx .vedettes__head h2 .light{ font-weight:300; color: var(--mute); }
.pblx .vedettes__nav{
  display:flex; gap:.5rem; align-items:center;
}
.pblx .vedettes__dots{ display:flex; gap:.5rem; }
.pblx .vedettes__dots button{
  width: 28px; height: 28px; border-radius:50%;
  border:1px solid var(--rule-strong);
  position:relative;
  transition: border-color .35s var(--ease), background .35s var(--ease);
}
.pblx .vedettes__dots button::after{
