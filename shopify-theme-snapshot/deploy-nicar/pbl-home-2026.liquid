/* Hero card-shuffle slider — next card rises from underneath, 2 others peek behind */
(function setupHeroShuffle(){
  const root  = document.getElementById("heroBottle");
  if(!root) return;
  const cards = Array.from(root.querySelectorAll(".hcard"));
  const dots  = root.querySelectorAll("#heroDots button");
  const nameEl = document.getElementById("heroName");
  if(cards.length < 2) return;
  const PERIOD = 5000;

  // Slot transforms: 0 = front, 1/2 = peeking behind + below
  const SLOTS = [
    { y: 0,   scale: 1,     opacity: 1,    z: 30, blur: 0 },
    { y: 38,  scale: 0.955, opacity: 0.78, z: 20, blur: 1 },
    { y: 70,  scale: 0.91,  opacity: 0.45, z: 10, blur: 2.2 },
  ];

  // order[k] = index of the card currently in slot k
  let order = cards.map((_, k) => k);
  let front = 0;       // index of card in front
  let timer, animating = false;

  function place(card, slot, animate){
    const s = SLOTS[slot];
    const props = {
      yPercent: 0, y: s.y, scale: s.scale, opacity: s.opacity,
      filter: `blur(${s.blur}px)`,
      zIndex: s.z,
    };
    if(animate){
      gsap.to(card, { ...props, duration: 0.75, ease: "power3.out" });
    } else {
      gsap.set(card, props);
    }
  }

  function render(animate){
    order.forEach((cardIdx, slot) => place(cards[cardIdx], slot, animate));
    front = order[0];
    dots.forEach((d, k) => d.setAttribute("aria-selected", k === front ? "true" : "false"));
    if(nameEl){
      nameEl.textContent = cards[front].dataset.name || "";
      gsap.fromTo(nameEl, { opacity: 0, y: 8 }, { opacity: 1, y: 0, duration: .5, ease: "power3.out" });
    }
  }

  // advance: the front card drops to the back; everyone shifts up one slot
  function next(){
    if(animating) return;
    animating = true;
    order = order.slice(1).concat(order[0]); // rotate forward
    render(true);
    setTimeout(() => { animating = false; }, 760);
  }

  // jump to a specific card index (by product), preserving the stack feel
  function goTo(cardIdx){
    if(animating || cardIdx === order[0]) return;
    animating = true;
    // rotate order until cardIdx is front
    while(order[0] !== cardIdx) order = order.slice(1).concat(order[0]);
    render(true);
    setTimeout(() => { animating = false; }, 760);
  }

  function play(){ clearInterval(timer); timer = setInterval(next, PERIOD); }
  function pause(){ clearInterval(timer); }

  dots.forEach((d, k) => d.addEventListener("click", () => { goTo(k); play(); }));
  root.addEventListener("mouseenter", pause);
  root.addEventListener("mouseleave", play);
  document.addEventListener("visibilitychange", () => document.hidden ? pause() : play());

  render(false);
  play();
})();

/* Nouveautés slider */
(function setupNouv(){
  const slides = document.querySelectorAll(".nouv__slide");
  const cur    = document.getElementById("nouvCur");
  const prev   = document.getElementById("nouvPrev");
  const next   = document.getElementById("nouvNext");
  const stage  = document.getElementById("nouvStage");
  if(!slides.length) return;
  let i = 0, timer;
  const PERIOD = 7000;

  function show(n){
    i = (n + slides.length) % slides.length;
    slides.forEach((s,k) => s.classList.toggle("is-active", k === i));
    if(cur) cur.textContent = String(i+1).padStart(2, "0");
  }
  function play(){ clearInterval(timer); timer = setInterval(() => show(i+1), PERIOD); }
  function pause(){ clearInterval(timer); }

  prev?.addEventListener("click", () => { show(i-1); play(); });
  next?.addEventListener("click", () => { show(i+1); play(); });
  stage?.addEventListener("mouseenter", pause);
  stage?.addEventListener("mouseleave", play);
  document.addEventListener("visibilitychange", () => document.hidden ? pause() : play());

  show(0); play();
})();

/* ─────────────────────────────────────────────────────────────────
   Awwwards transitions — curtain reveal on dark sections + chapter
   ───────────────────────────────────────────────────────────────── */

/* Section data — drives the chapter floating mark */
const CHAPTERS = [
  { sel: '.hero',        num: '01', title: 'Probiotiques',  dark: false },
  { sel: '.manifesto',   num: '02', title: 'Manifeste',     dark: true  },
  { sel: '.qc__grid',    num: '03', title: 'Québec',        dark: true  },
  { sel: '#formules',    num: '04', title: 'Formules',      dark: false },
  { sel: '#nouveautes',  num: '05', title: 'Nouveautés',    dark: false },
  { sel: '#etudes',      num: '06', title: 'Études',        dark: true  },
  { sel: '#final',       num: '07', title: 'Commencer',     dark: true  },
];

const chapEl    = document.getElementById('chap');
const chapNum   = document.getElementById('chapNum');
const chapTitle = document.getElementById('chapTitle');

function setChapter(c){
  if(!c) return;
  chapNum.textContent = c.num;
  chapTitle.textContent = c.title;
  chapEl.classList.toggle('on-dark__chap', c.dark);
}

/* Chapter detection on dark sections (curtain removed for robustness) */
gsap.utils.toArray('.on-dark').forEach(sec => {
  const ch = CHAPTERS.find(c => sec.matches(c.sel));
  if(ch){
    ScrollTrigger.create({
      trigger: sec,
      start: 'top 60%',
      end: 'bottom 40%',
      onEnter:    () => { setChapter(ch); chapEl.classList.add('is-visible'); },
      onEnterBack:() => { setChapter(ch); chapEl.classList.add('is-visible'); },
    });
  }
});

/* Light sections also report their chapter */
CHAPTERS.filter(c => !c.dark).forEach(c => {
  const sec = document.querySelector(c.sel);
  if(!sec) return;
  ScrollTrigger.create({
    trigger: sec,
    start: 'top 60%',
    end: 'bottom 40%',
    onEnter:    () => { setChapter(c); chapEl.classList.add('is-visible'); },
    onEnterBack:() => { setChapter(c); chapEl.classList.add('is-visible'); },
  });
});

/* Hide chapter at the very top */
ScrollTrigger.create({
  start: 'top top',
  end: '+=180',
  onUpdate: self => chapEl.classList.toggle('is-visible', self.progress > 0.6 ? true : chapEl.classList.contains('is-visible')),
  onLeaveBack: () => chapEl.classList.remove('is-visible'),
});

/* Scroll progress bar */
const progressBar = document.getElementById('progressBar');
ScrollTrigger.create({
  start: 0, end: 'max',
  onUpdate: self => {
    if(progressBar) progressBar.style.width = (self.progress * 100) + '%';
  },
});

/* Custom cursor — premium magnetic dot */
(function setupCursor(){
  const cur = document.getElementById('cursor');
  if(!cur) return;
  if(window.matchMedia('(hover: none), (max-width: 760px)').matches) return;

  let mx = window.innerWidth/2, my = window.innerHeight/2;
  let cx = mx, cy = my;
  let visible = false;

  window.addEventListener('mousemove', e => {
    mx = e.clientX; my = e.clientY;
    if(!visible){ cur.style.opacity = '1'; visible = true; }
  });
  window.addEventListener('mouseleave', () => { cur.style.opacity = '0'; visible = false; });

  // hover state on interactive elements
  document.querySelectorAll('a, button, .btn, .formule-card, .mega__card, .index-row, .nav__icobtn, .vedettes__arrow, .nouv__nav button, .mega__cats button, .chip').forEach(el => {
    el.addEventListener('mouseenter', () => cur.classList.add('is-hover'));
    el.addEventListener('mouseleave', () => cur.classList.remove('is-hover'));
  });

  function tick(){
    cx += (mx - cx) * 0.18;
    cy += (my - cy) * 0.18;
    cur.style.transform = `translate3d(${cx}px, ${cy}px, 0) translate(-50%, -50%)`;
    requestAnimationFrame(tick);
  }
  tick();
})();

/* Word-by-word entrance for every section h2 */
gsap.utils.toArray('section h2, .hero__h1').forEach(h => {
  if(h.dataset.split === '') return; // manifesto handled separately
  const text = h.innerHTML;
  // skip if it already contains spans we built
  if(h.querySelector('.line')) return;
  const words = h.textContent.trim().split(/\s+/);
  h.innerHTML = words.map(w => `<span class="w" style="display:inline-block;overflow:hidden;padding:0 .12em 0 0;"><span style="display:inline-block;transform:translateY(110%);">${w}</span></span>`).join(' ');
});

ScrollTrigger.batch('section h2 .w > span, .hero__h1 .w > span', {
  start: 'top 88%',
  onEnter: batch => gsap.to(batch, {
    y: 0,
    duration: 1.1,
    ease: 'power4.out',
    stagger: 0.035,
  }),
  once: true,
});

/* Magnetic buttons */
document.querySelectorAll('.btn').forEach(b => {
  let mag;
  b.addEventListener('mouseenter', () => {
    const r = b.getBoundingClientRect();
    mag = (e) => {
      const dx = (e.clientX - (r.left + r.width/2)) * 0.18;
      const dy = (e.clientY - (r.top + r.height/2)) * 0.18;
      b.style.transform = `translate(${dx}px, ${dy}px)`;
    };
    window.addEventListener('mousemove', mag);
  });
  b.addEventListener('mouseleave', () => {
    window.removeEventListener('mousemove', mag);
    gsap.to(b, { x:0, y:0, duration:.6, ease:'elastic.out(1, 0.5)', clearProps:'transform' });
  });
});

} // /IS_STATIC else

</script>

