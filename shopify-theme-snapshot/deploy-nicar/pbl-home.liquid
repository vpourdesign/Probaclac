{% comment %} ============================================================
  PROBACLAC HOMEPAGE — "Pharmacie éditoriale"
  Design system: Gunmetal + Ivory + Orange. Ubuntu Bold + Open Sans.
  Sections: 1.Hero · 2.Marquee · 3.Manifeste · 4.Bento stats · 5.Formules
           6.Microbiote (Rosella) · 7.Études · 8.CTA
============================================================ {% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@500;700&family=Open+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
  /* ─── DESIGN TOKENS ─────────────────────────────────────── */
  .pbl-home{
    --gunmetal:#233038; --ink:#0C0920;
    --orange:#FF5B04; --orange-soft:#FFB089;
    --green:#075056; --green-soft:#2A7B7C;
    --sand:#F4D47C; --silver:#D3DBDD; --ivory:#FEFAF1;
    --paper:#FDFBF6; --white:#FFFFFF;
    --rule:rgba(35,48,56,.12);
    --rule-soft:rgba(35,48,56,.06);
    --shadow-sm: 0 1px 2px rgb(35 48 56 / .06), 0 2px 8px rgb(35 48 56 / .04);
    --shadow-md: 0 4px 16px rgb(35 48 56 / .08), 0 16px 40px rgb(35 48 56 / .08);
    --shadow-lg: 0 20px 60px rgb(35 48 56 / .15), 0 8px 24px rgb(35 48 56 / .08);
    --ease-out: cubic-bezier(.16,1,.3,1);
    --ease-spring: cubic-bezier(.22,1.2,.32,1);
    --t-eyebrow: clamp(.7rem, .8vw, .82rem);
    --t-body: clamp(.98rem, 1.05vw, 1.1rem);
    --t-lead: clamp(1.1rem, 1.4vw, 1.35rem);
    --t-h3: clamp(1.6rem, 2.5vw, 2.5rem);
    --t-h2: clamp(2.4rem, 5vw, 4.2rem);
    --t-h1: clamp(3.2rem, 8vw, 8rem);
    --t-display: clamp(4rem, 12vw, 13rem);
    font-family: 'Open Sans', system-ui, sans-serif;
    font-size: var(--t-body);
    color: var(--gunmetal);
    line-height: 1.6;
    background: var(--paper);
  }
  .pbl-home *, .pbl-home *::before, .pbl-home *::after { box-sizing: border-box; }
  .pbl-home h1,.pbl-home h2,.pbl-home h3,.pbl-home h4{
    font-family:'Ubuntu',sans-serif; font-weight:700;
    letter-spacing:-.025em; line-height:1.02; margin:0;
  }
  .pbl-home p{margin:0;max-width:60ch}
  .pbl-home a{color:inherit; text-decoration:none}
  .pbl-home .eyebrow{
    font-family:'Open Sans',sans-serif; font-weight:600;
    font-size:var(--t-eyebrow); letter-spacing:.18em; text-transform:uppercase;
    display:inline-flex; align-items:center; gap:.55rem;
  }
  .pbl-home .eyebrow::before{
    content:''; width:32px; height:1px; background:currentColor; opacity:.7;
  }
  .pbl-home .container{
    max-width:1440px; margin-inline:auto;
    padding-inline:clamp(1.25rem, 4vw, 3.5rem);
  }

  /* Reveal on scroll (IntersectionObserver) */
  .pbl-home .reveal{ opacity:0; transform:translateY(28px); transition:opacity .9s var(--ease-out), transform .9s var(--ease-out); }
  .pbl-home .reveal.in{ opacity:1; transform:none; }
  .pbl-home .reveal.d1{ transition-delay:.08s }
  .pbl-home .reveal.d2{ transition-delay:.18s }
  .pbl-home .reveal.d3{ transition-delay:.28s }
  .pbl-home .reveal.d4{ transition-delay:.38s }
  .pbl-home .reveal.d5{ transition-delay:.48s }

  /* ─── 0. NAVBAR + MEGAMENU ──────────────────────────── */
  .pbl-nav{
    position:sticky; top:0; z-index:80;
    background:rgba(251,247,238,.82); backdrop-filter: blur(14px) saturate(180%);
    border-bottom:1px solid var(--rule-soft);
    transition: background .3s, border-color .3s;
  }
  .pbl-nav.open{ background:var(--paper); border-bottom-color:transparent; }
  .pbl-nav__inner{
    max-width:1440px; margin-inline:auto; padding-inline: clamp(1.25rem,4vw,3.5rem);
    height:72px; display:grid; grid-template-columns: auto 1fr auto; align-items:center; gap:2rem;
  }
  .pbl-nav__logo{
    display:inline-flex; align-items:center;
  }
  .pbl-nav__logo img{
    height:28px; width:auto; display:block;
  }
  @media (max-width:540px){ .pbl-nav__logo img{ height:24px; } }
  .pbl-nav__center{ display:flex; justify-content:center; gap:clamp(1.25rem,3vw,2.5rem); }
  .pbl-nav__link{
    font-family:'Open Sans',sans-serif; font-weight:600; font-size:.92rem;
    color:var(--gunmetal); padding:.5rem 0; position:relative;
    transition:color .25s;
    display:inline-flex; align-items:center; gap:.35rem;
  }
  .pbl-nav__link:hover{ color:var(--orange); }
  .pbl-nav__link[aria-expanded="true"]{ color:var(--orange); }
  .pbl-nav__link .chev{
    display:inline-block; width:9px; height:9px;
    border-right:1.5px solid currentColor; border-bottom:1.5px solid currentColor;
    transform:rotate(45deg) translate(-2px,-2px); transition:transform .35s var(--ease-spring);
  }
  .pbl-nav__link[aria-expanded="true"] .chev{ transform:rotate(-135deg) translate(-2px,-2px); }
  .pbl-nav__right{ display:flex; align-items:center; gap:.5rem; }
  .pbl-nav__lang{
    font-size:.76rem; font-weight:700; letter-spacing:.18em; color:rgba(35,48,56,.4);
    display:inline-flex; align-items:center; gap:.15rem; margin-right:.35rem;
  }
  .pbl-nav__lang a{ padding:.35rem .45rem; border-radius:6px; transition:color .25s, background .25s; }
  .pbl-nav__lang a:hover{ color:var(--gunmetal); }
  .pbl-nav__lang a.on{ color:var(--gunmetal); }
  .pbl-nav__lang span.sep{ color:rgba(35,48,56,.2); padding:0 .15rem; }
  .pbl-nav__ico{
    display:inline-flex; align-items:center; justify-content:center;
    width:38px; height:38px; border-radius:50%;
    color:var(--gunmetal); background:transparent;
    transition: background .25s, color .25s, transform .3s var(--ease-spring);
    position:relative;
  }
  .pbl-nav__ico:hover{ background:rgba(35,48,56,.06); transform:translateY(-1px); }
  .pbl-nav__ico svg{
    width:18px; height:18px; stroke:currentColor; fill:none;
    stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round;
  }
  .pbl-nav__ico .badge-count{
    position:absolute; top:5px; right:5px;
    min-width:16px; height:16px; padding:0 4px;
    background:var(--orange); color:#fff; border-radius:9px;
    font-size:.62rem; font-weight:700; letter-spacing:0;
    display:grid; place-items:center;
    border:2px solid var(--paper);
  }

  /* Mega overlay */
  .pbl-mega-backdrop{
    position:fixed; inset:72px 0 0 0; z-index:78;
    background:rgba(12,9,32,.32); backdrop-filter: blur(2px);
    opacity:0; visibility:hidden; transition:opacity .35s, visibility .35s;
  }
  .pbl-mega-backdrop.on{ opacity:1; visibility:visible; }

  .pbl-mega{
    position:absolute; left:0; right:0; top:100%; z-index:79;
    background:var(--paper); border-top:1px solid var(--rule-soft);
    box-shadow: 0 30px 60px -20px rgba(12,9,32,.18), 0 8px 24px -8px rgba(12,9,32,.08);
    opacity:0; visibility:hidden; transform:translateY(-12px);
    transition: opacity .4s var(--ease-out), transform .55s var(--ease-spring), visibility .4s;
    pointer-events:none;
  }
  .pbl-mega.open{ opacity:1; visibility:visible; transform:none; pointer-events:auto; }
  .pbl-mega__inner{
    max-width:1440px; margin-inline:auto;
    padding: clamp(1.25rem, 2vw, 2rem) clamp(1.25rem, 4vw, 3.5rem) clamp(1.5rem, 2.5vw, 2rem);
    display:grid; grid-template-columns: 200px 1fr 260px; gap: clamp(1.5rem, 3vw, 2.5rem);
    max-height: calc(100vh - 72px);
    overflow-y: auto;
  }
  @media (max-width:1100px){
    .pbl-mega__inner{ grid-template-columns: 200px 1fr; }
    .pbl-mega__aside{ display:none; }
  }
  @media (max-width:780px){
    .pbl-mega__inner{ grid-template-columns: 1fr; gap:1.5rem; }
    .pbl-mega__cats{ display:flex; gap:.5rem; overflow-x:auto; padding-bottom:.5rem; }
  }

  /* Left: categories */
  .pbl-mega__head{
    grid-column: 1 / -1;
    display:flex; justify-content:space-between; align-items:baseline; gap:2rem;
    padding-bottom:.85rem; margin-bottom:.5rem; border-bottom:1px solid var(--rule-soft); flex-wrap:wrap;
  }
  .pbl-mega__head .eyebrow{ color:var(--orange); }
  .pbl-mega__head h3{
    font-family:'Ubuntu',sans-serif; font-weight:700;
    font-size: clamp(1.2rem, 1.6vw, 1.55rem); color:var(--gunmetal);
    letter-spacing:-.02em; line-height:1.15; margin-top:.4rem;
  }
  .pbl-mega__head .meta{ font-size:.85rem; color:rgba(35,48,56,.6); }
  .pbl-mega__head .meta b{ color:var(--gunmetal); font-weight:700; }

  .pbl-mega__cats{ display:flex; flex-direction:column; gap:.15rem; }
  @media (max-width:780px){
    .pbl-mega__cats{ flex-direction:row; }
  }
  .pbl-cat{
    padding:.85rem 1rem; border-radius:10px; border:0; background:transparent;
    text-align:left; cursor:pointer; font:inherit;
    display:flex; align-items:center; justify-content:space-between; gap:.75rem;
    color:rgba(35,48,56,.7); transition:background .3s, color .3s;
  }
  .pbl-cat:hover{ background:rgba(35,48,56,.04); color:var(--gunmetal); }
  .pbl-cat.active{ background:var(--gunmetal); color:#fff; }
  .pbl-cat__lbl{ font-weight:600; font-size:.92rem; letter-spacing:-.005em; }
  .pbl-cat__count{
    font-family:'Ubuntu',sans-serif; font-weight:700; font-size:.72rem;
    letter-spacing:.06em;
    padding:.18rem .42rem; border-radius:6px;
    background:rgba(35,48,56,.08); color:rgba(35,48,56,.6);
  }
  .pbl-cat.active .pbl-cat__count{ background:rgba(255,255,255,.18); color:#fff; }
  .pbl-cat--qd{ --catc:#FF5B04; }
  .pbl-cat--cd{ --catc:#075056; }
  .pbl-cat--fm{ --catc:#D62983; }

  /* Center: products grid */
  .pbl-mega__grid{
    display:grid; grid-template-columns: repeat(4, 1fr); gap:.75rem;
    align-content:start;
  }
  @media (max-width:980px){ .pbl-mega__grid{ grid-template-columns: repeat(3, 1fr); } }
  @media (max-width:680px){ .pbl-mega__grid{ grid-template-columns: repeat(2, 1fr); } }

  .pbl-mega-card{
    position:relative; display:block; background:var(--white);
    border-radius:12px; overflow:hidden; text-decoration:none;
    border:1px solid var(--rule-soft);
    transition: transform .35s var(--ease-spring), border-color .3s, box-shadow .35s;
    /* Stagger entry */
    opacity:0; transform:translateY(12px);
  }
  .pbl-mega.open .pbl-mega-card{
    opacity:1; transform:none;
    transition: opacity .55s var(--ease-out), transform .65s var(--ease-spring), border-color .3s, box-shadow .35s;
  }
  .pbl-mega.open .pbl-mega-card:nth-child(1){ transition-delay:.04s }
  .pbl-mega.open .pbl-mega-card:nth-child(2){ transition-delay:.08s }
  .pbl-mega.open .pbl-mega-card:nth-child(3){ transition-delay:.12s }
  .pbl-mega.open .pbl-mega-card:nth-child(4){ transition-delay:.16s }
  .pbl-mega.open .pbl-mega-card:nth-child(5){ transition-delay:.20s }
  .pbl-mega.open .pbl-mega-card:nth-child(6){ transition-delay:.24s }
  .pbl-mega.open .pbl-mega-card:nth-child(7){ transition-delay:.28s }
  .pbl-mega.open .pbl-mega-card:nth-child(8){ transition-delay:.32s }
  .pbl-mega.open .pbl-mega-card:nth-child(9){ transition-delay:.36s }
  .pbl-mega.open .pbl-mega-card:nth-child(10){ transition-delay:.40s }
  .pbl-mega.open .pbl-mega-card:nth-child(11){ transition-delay:.44s }
  .pbl-mega.open .pbl-mega-card:nth-child(12){ transition-delay:.48s }

  .pbl-mega-card:hover{
    transform:translateY(-4px); border-color:transparent;
    box-shadow: 0 14px 36px rgba(35,48,56,.10), 0 4px 12px rgba(35,48,56,.06);
  }
  .pbl-mega-card.is-hidden{ display:none !important; }

  .pbl-mega-card__img{
    aspect-ratio:4/3; overflow:hidden; background:#F4F2EC;
  }
  .pbl-mega-card__img img{
    width:100%; height:100%; object-fit:cover; display:block;
    transition: transform .7s var(--ease-out);
  }
  .pbl-mega-card:hover .pbl-mega-card__img img{ transform:scale(1.06); }
  .pbl-mega-card__body{
    padding:.5rem .65rem .65rem; display:flex; flex-direction:column; gap:.2rem;
  }
  .pbl-mega-card__tag{
    display:inline-flex; align-items:center; gap:.35rem;
    font-family:'Open Sans',sans-serif; font-weight:700;
    font-size:.6rem; letter-spacing:.14em; text-transform:uppercase;
    color: var(--catc, var(--orange));
  }
  .pbl-mega-card__tag::before{
    content:''; width:5px; height:5px; border-radius:50%;
    background:currentColor; box-shadow: 0 0 8px currentColor;
  }
  .pbl-mega-card--qd{ --catc:#FF5B04; }
  .pbl-mega-card--cd{ --catc:#075056; }
  .pbl-mega-card--fm{ --catc:#D62983; }
  .pbl-mega-card__name{
    font-family:'Ubuntu',sans-serif; font-weight:700;
    font-size:.85rem; line-height:1.18; color:var(--gunmetal); margin:0;
    letter-spacing:-.01em;
  }
  .pbl-mega-card__meta{
    font-size:.68rem; color:rgba(35,48,56,.55); font-weight:500; line-height:1.3;
  }
  .pbl-mega-card__npn{
    position:absolute; top:.6rem; right:.6rem; z-index:2;
    font-size:.62rem; font-weight:700; letter-spacing:.06em;
    color:rgba(35,48,56,.55);
    padding:.18rem .42rem; border-radius:5px;
    background:rgba(255,255,255,.88); backdrop-filter:blur(6px);
  }

  /* Right: aside */
  .pbl-mega__aside{ display:flex; flex-direction:column; gap:1.25rem; }
  .pbl-mega__aside-card{
    padding:1.25rem 1.25rem 1.4rem; border-radius:14px;
    background:var(--gunmetal); color:#fff; position:relative; overflow:hidden;
  }
  .pbl-mega__aside-card::before{
    content:''; position:absolute; inset:0; pointer-events:none;
    background:
      radial-gradient(60% 70% at 0% 100%, rgba(255,91,4,.25), transparent 60%),
      radial-gradient(50% 60% at 100% 0%, rgba(7,80,86,.5), transparent 60%);
  }
  .pbl-mega__aside-card > *{ position:relative; }
  .pbl-mega__aside-card .eyebrow{ color:var(--sand); font-size:.7rem; }
  .pbl-mega__aside-card h4{
    font-family:'Ubuntu',sans-serif; font-weight:700;
    font-size:1.25rem; line-height:1.15; letter-spacing:-.01em;
    margin:.75rem 0 .65rem;
  }
  .pbl-mega__aside-card p{
    font-size:.84rem; color:rgba(255,255,255,.72); margin-bottom:1rem; line-height:1.5;
  }
  .pbl-mega__aside-card a{
    display:inline-flex; align-items:center; gap:.4rem;
    color:var(--sand); font-weight:700; font-size:.82rem;
    border-bottom:1px solid rgba(244,212,124,.4); padding-bottom:.15rem;
    transition: gap .3s var(--ease-spring), color .25s;
  }
  .pbl-mega__aside-card a:hover{ color:#fff; gap:.6rem; }
  .pbl-mega__aside-card a svg{ width:13px; height:13px; }

  .pbl-mega__aside-stat{
    padding:1.25rem; border-radius:14px; background:var(--white);
    border:1px solid var(--rule-soft);
  }
  .pbl-mega__aside-stat .num{
    font-family:'Ubuntu',sans-serif; font-weight:700;
    font-size:2.25rem; line-height:1; color:var(--gunmetal); letter-spacing:-.04em;
  }
  .pbl-mega__aside-stat .num .sym{ color:var(--orange); }
  .pbl-mega__aside-stat p{ font-size:.78rem; color:rgba(35,48,56,.65); line-height:1.5; margin-top:.6rem; }

  /* Mobile hamburger (not implementing full mobile nav — keep simple) */
  @media (max-width:780px){
    .pbl-nav__center{ display:none; }
  }

  /* ─── 1. HERO ─────────────────────────────────────────── */
  .pbl-hero{
    position:relative; min-height:100svh; min-height:780px;
    background:var(--gunmetal); color:var(--white); overflow:hidden;
    display:flex; align-items:stretch;
  }
  .pbl-hero__bg{
    position:absolute; inset:0; z-index:0; overflow:hidden;
  }
  .pbl-hero__bg img{
    width:100%; height:100%; object-fit:cover; object-position: center center;
    transform:scale(1.04); transition:transform 1.4s var(--ease-out);
  }
  .pbl-hero.in .pbl-hero__bg img{ transform:scale(1); }
  /* No overlay on the image — it would darken the product bottles on the right.
     The image itself is darker on its left portion, where the text sits. */
  .pbl-hero__dot-overlay{ display:none; }
  .pbl-hero__inner{
    position:relative; z-index:2; width:100%;
    display:grid; grid-template-columns: 1fr; align-content:end;
    padding: clamp(5rem,12vh,9rem) clamp(1.25rem,4vw,3.5rem) clamp(2rem,5vw,4rem);
  }
  /* Content stays in left ~42% of viewport to never overlap the bottles on the right */
  .pbl-hero__content{ max-width: min(640px, 44vw); }
  @media (max-width:880px){ .pbl-hero__content{ max-width:100%; } }
  .pbl-hero__meta{
    display:flex; gap:clamp(.75rem,2vw,1.5rem); flex-wrap:wrap; align-items:baseline;
    margin-bottom:clamp(1.5rem,3vw,2.25rem);
  }
  .pbl-hero__meta .eyebrow{ color:rgba(255,255,255,.7); }
  .pbl-hero__meta .badge{
    display:inline-flex; align-items:center; gap:.5rem;
    padding:.45rem .9rem; border:1px solid rgba(255,255,255,.25);
    border-radius:100px; font-size:.78rem; font-weight:600; color:rgba(255,255,255,.9);
    backdrop-filter: blur(8px); background:rgba(35,48,56,.35);
  }
  .pbl-hero__meta .badge .dot{ width:6px; height:6px; border-radius:50%; background:var(--sand); box-shadow:0 0 12px var(--sand); }
  .pbl-hero h1{
    font-size: clamp(2.2rem, 4.5vw, 4.2rem);
    line-height:1.04;
    margin-bottom:clamp(1.25rem,2.5vw,2rem);
  }
  .pbl-hero h1 .accent{ color:var(--orange); }
  .pbl-hero h1 .stack{ display:block; }
  .pbl-hero__sub{
    font-size: clamp(1rem, 1.2vw, 1.18rem); color:rgba(255,255,255,.88);
    max-width:42ch; margin-bottom:clamp(1.75rem,3vw,2.5rem); font-weight:400;
  }
  .pbl-hero__sub strong{ color:#fff; font-weight:700; }
  .pbl-hero__ctas{
    display:flex; gap:.85rem; flex-wrap:wrap; align-items:center;
  }
  .pbl-btn{
    display:inline-flex; align-items:center; gap:.6rem;
    padding:1.05rem 2rem; border-radius:100px; font-weight:700;
    font-size:.9rem; letter-spacing:.02em;
    cursor:pointer; transition:all .35s var(--ease-spring);
    border:1px solid transparent; font-family:inherit;
  }
  .pbl-btn--primary{ background:var(--orange); color:#fff; box-shadow: 0 10px 30px rgba(255,91,4,.35); }
  .pbl-btn--primary:hover{ transform:translateY(-2px); box-shadow: 0 16px 40px rgba(255,91,4,.45); background:#ff6e22; }
  .pbl-btn--ghost{ background:transparent; color:#fff; border-color:rgba(255,255,255,.35); }
  .pbl-btn--ghost:hover{ background:rgba(255,255,255,.1); border-color:rgba(255,255,255,.6); transform:translateY(-2px); }
  .pbl-btn--dark{ background:var(--gunmetal); color:#fff; }
  .pbl-btn--dark:hover{ transform:translateY(-2px); background:var(--ink); box-shadow: 0 14px 30px rgba(12,9,32,.3); }
  .pbl-btn svg{ width:14px; height:14px; transition:transform .3s var(--ease-spring); }
  .pbl-btn:hover svg{ transform:translateX(4px); }

  /* Hero side number column — hidden to never overlap the bottles in bg image */
  .pbl-hero__side{ display:none; }

  .pbl-hero__scroll{
    position:absolute; left:clamp(1.25rem,4vw,3.5rem); bottom:1.5rem;
    z-index:3; font-size:.7rem; letter-spacing:.18em; text-transform:uppercase;
    color:rgba(255,255,255,.55); display:flex; align-items:center; gap:.6rem;
  }
  .pbl-hero__scroll::after{
    content:''; width:1px; height:36px; background:rgba(255,255,255,.5);
    animation: scrollPulse 2.4s ease-in-out infinite; transform-origin:top;
  }
  @keyframes scrollPulse { 0%,100%{ transform:scaleY(.3) } 50%{ transform:scaleY(1) } }

  /* ─── 2. MARQUEE — removed ──────────────────────────── */

  /* ─── 3. MANIFESTE ────────────────────────────────────── */
  .pbl-manifeste{
    background:var(--paper); padding: clamp(5rem,10vw,9rem) 0;
    position:relative;
  }
  .pbl-manifeste__grid{
    display:grid; grid-template-columns: 1fr; gap:clamp(2.5rem,5vw,4.5rem);
  }
  @media (min-width:880px){
    .pbl-manifeste__grid{ grid-template-columns: 1.15fr 1fr; align-items:start; }
  }
  .pbl-manifeste h2{
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    max-width:15ch;
  }
  .pbl-manifeste h2 .accent{ color:var(--orange); }
  .pbl-manifeste h2 .gn{ color:var(--green); }
  .pbl-manifeste__lead{
    font-size: var(--t-lead); color:rgba(35,48,56,.78);
    max-width:52ch; margin-top:2rem; font-weight:400;
  }
  .pbl-manifeste__pillars{
    display:flex; flex-direction:column; gap:0;
