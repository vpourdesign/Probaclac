            Découvrir les formules
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="https://etudes.probaclac.ca/" class="pbl-btn pbl-btn--ghost">Lire la science</a>
        </div>
      </div>
    </div>
  </section>

  <div class="pbl-signature">
    Probaclac · Probiotiques de grade pharmaceutique · Conçu et fabriqué <span class="it">au Québec</span>
  </div>

</div>

<script>
  (function(){
    var root = document.currentScript.closest('.shopify-section') || document.body;

    /* Reveal on scroll */
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    root.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });

    /* Nouveautés slider */
    var slider = root.querySelector('#pblSlider');
    if (!slider) return;
    var track   = slider.querySelector('#pblSliderTrack');
    var slides  = slider.querySelectorAll('.pbl-slide');
    var dots    = slider.querySelectorAll('.pbl-slider__dot');
    var counter = slider.querySelector('#pblSliderCur');
    var prevBtn = slider.querySelector('#pblSliderPrev');
    var nextBtn = slider.querySelector('#pblSliderNext');
    var current = 0;
    var total   = slides.length;
    var autoplayMs = parseInt(slider.dataset.autoplay || '7000', 10);
    var timer = null;
    var paused = false;

    function pad(n){ return n < 10 ? '0' + n : '' + n; }
    function go(idx){
      current = ((idx % total) + total) % total;
      track.style.transform = 'translateX(' + (-current * 100) + '%)';
      slides.forEach(function(s, i){
        s.classList.toggle('active', i === current);
        if (i === current) { s.removeAttribute('hidden'); } else { s.setAttribute('hidden', ''); }
      });
      dots.forEach(function(d, i){ d.classList.toggle('active', i === current); });
      if (counter) counter.textContent = pad(current + 1);
    }
    function next(){ go(current + 1); }
    function prev(){ go(current - 1); }
    function restart(){
      if (timer) clearInterval(timer);
      if (!paused && autoplayMs > 0) timer = setInterval(next, autoplayMs);
    }

    prevBtn && prevBtn.addEventListener('click', function(){ prev(); restart(); });
    nextBtn && nextBtn.addEventListener('click', function(){ next(); restart(); });
    dots.forEach(function(d){
      d.addEventListener('click', function(){ go(parseInt(d.dataset.go, 10)); restart(); });
    });
    slider.addEventListener('mouseenter', function(){ paused = true; if (timer) clearInterval(timer); });
    slider.addEventListener('mouseleave', function(){ paused = false; restart(); });

    /* Keyboard nav when slider in viewport + focused */
    slider.tabIndex = 0;
    slider.addEventListener('keydown', function(e){
      if (e.key === 'ArrowLeft')  { prev(); restart(); }
      if (e.key === 'ArrowRight') { next(); restart(); }
    });

    /* Start autoplay only when slider enters viewport */
    var sliderIO = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) { restart(); sliderIO.disconnect(); }
      });
    }, { threshold: 0.25 });
    sliderIO.observe(slider);

    /* ── Megamenu ── */
    var nav      = root.querySelector('#pblNav');
    var trigger  = root.querySelector('#pblNavProducts');
    var mega     = root.querySelector('#pblMega');
    var backdrop = root.querySelector('#pblMegaBackdrop');
    var cats     = mega && mega.querySelectorAll('.pbl-cat');
    var cards    = mega && mega.querySelectorAll('.pbl-mega-card');
    var countEl  = mega && mega.querySelector('#pblMegaCount');
    if (!trigger || !mega) return;

    var megaOpen = false;
    var closeTimer = null;

    function openMega(){
      if (megaOpen) return;
      megaOpen = true;
      mega.removeAttribute('hidden');
      requestAnimationFrame(function(){
        mega.classList.add('open');
        backdrop.classList.add('on');
        nav.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
      });
    }
    function closeMega(){
      if (!megaOpen) return;
      megaOpen = false;
      mega.classList.remove('open');
      backdrop.classList.remove('on');
      nav.classList.remove('open');
      trigger.setAttribute('aria-expanded', 'false');
      setTimeout(function(){ if (!megaOpen) mega.setAttribute('hidden', ''); }, 450);
    }

    /* Hover intent — open on hover, delayed close */
    function clearClose(){ if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; } }
    function scheduleClose(){ clearClose(); closeTimer = setTimeout(closeMega, 220); }

    trigger.addEventListener('mouseenter', function(){ clearClose(); openMega(); });
    trigger.addEventListener('focus', function(){ openMega(); });
    trigger.addEventListener('click', function(e){
      e.preventDefault();
      megaOpen ? closeMega() : openMega();
    });
    mega.addEventListener('mouseenter', clearClose);
    mega.addEventListener('mouseleave', scheduleClose);
    trigger.addEventListener('mouseleave', scheduleClose);
    backdrop.addEventListener('click', closeMega);
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && megaOpen) { closeMega(); trigger.focus(); }
    });

    /* Category filtering — hide cards entirely so the grid reflows */
    if (cats && cards){
      cats.forEach(function(c){
        c.addEventListener('click', function(){
          var cat = c.dataset.cat;
          cats.forEach(function(x){ x.classList.toggle('active', x === c); x.setAttribute('aria-selected', x === c ? 'true' : 'false'); });
          var shown = 0;
          cards.forEach(function(card){
            var match = (cat === 'all') || (card.dataset.cat === cat);
            card.classList.toggle('is-hidden', !match);
            if (match) shown++;
          });
          if (countEl) countEl.textContent = shown;
        });
      });
    }
  })();
</script>

